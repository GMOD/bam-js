{
  "extends": "./tsconfig",
  "compilerOptions": {
    // tsconfig.json compiles src/ into dist/. This one only ever reads, so it
    // needs a rootDir that spans test/ as well and no output at all.
    "rootDir": ".",
    "noEmit": true
  },
  // vitest.config.ts is listed too: eslint is type-aware here, so a file it
  // lints but this project does not include fails to parse at all.
  "include": ["src", "test", "vitest.config.ts"]
}

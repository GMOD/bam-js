// Source for docs/img/dataflow.svg, which docs/dataflow.md embeds.
// Regenerate with: dot -Tsvg docs/img/dataflow.dot -o docs/img/dataflow.svg
//
// Deliberately the MAIN PATH only — htsget, viewAsPairs mate lookups, the
// reference-sequence pass and the early stop are described in dataflow.md
// instead. A diagram that shows every branch stops being the thing you look at
// first.
//
// SYNC: ~/src/gmod/tabix-js/docs/img/dataflow.dot — same palette, legend and
// spine.
digraph bamjs {
  rankdir=TB
  bgcolor="white"
  nodesep=0.3
  ranksep=0.36
  node [shape=box style="filled,rounded" fillcolor="#f6f8fa" color="#57606a"
        fontname="Helvetica" fontsize=10 margin="0.14,0.07"]
  edge [color="#57606a" fontname="Helvetica" fontsize=9]

  query   [label="getRecordsForRange(chr, min, max)" fillcolor="#ddf4ff" color="#0969da"]
  readidx [label="read .bai / .csi" fillcolor="#dafbe1" color="#1a7f37"]
  readhdr [label="read BAM header" fillcolor="#dafbe1" color="#1a7f37"]
  unzip   [label="unzip" fillcolor="#ffd8b5" color="#bc4c00"]
  index   [label="index + header" fillcolor="#fff8c5" color="#9a6700"]
  blocks  [label="blocksForRange"]
  cache   [label="chunkFeatureCache" fillcolor="#fff8c5" color="#9a6700"]
  readchk [label="read chunk range" fillcolor="#dafbe1" color="#1a7f37"]
  slice   [label="unzipChunkSlice" fillcolor="#ffd8b5" color="#bc4c00"]
  pool    [label="worker pool" fillcolor="#ffd8b5" color="#bc4c00"]
  feats   [label="readBamFeatures"]
  out     [label="BamRecord[]" fillcolor="#ddf4ff" color="#0969da"]

  query -> readidx
  readidx -> index
  readidx -> unzip [style=dashed label=" csi "]
  query -> readhdr
  readhdr -> unzip
  unzip -> index
  index -> blocks
  blocks -> cache [label=" Chunk[] "]
  cache -> readchk [label=" miss "]
  readchk -> slice
  slice -> pool [style=dashed label=" optional "]
  slice -> feats
  pool -> feats
  cache -> feats [label=" hit "]
  feats -> out [label=" in range "]

  subgraph cluster_legend {
    label="Legend"
    labelloc="t"
    fontname="Helvetica"
    fontsize=10
    fontcolor="#57606a"
    color="#d0d7de"
    style="rounded"
    margin=10
    node [shape=box style="filled,rounded" fontsize=9 margin="0.1,0.04"]
    l1 [label="I/O" fillcolor="#dafbe1" color="#1a7f37"]
    l2 [label="wasm" fillcolor="#ffd8b5" color="#bc4c00"]
    l3 [label="cached / shared" fillcolor="#fff8c5" color="#9a6700"]
    l1 -> l2 -> l3 [style=invis]
  }
}

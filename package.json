{
  "name": "@gmod/bam",
  "version": "10.2.0",
  "packageManager": "pnpm@11.15.1",
  "description": "Parser for BAM and BAM index (bai) files",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GMOD/bam-js.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "exports": {
    "import": "./esm/index.js",
    "require": "./dist/index.js"
  },
  "author": {
    "name": "Colin Diesh",
    "email": "colin.diesh@gmail.com",
    "url": "https://github.com/cmdcolin"
  },
  "files": [
    "dist",
    "esm",
    "src"
  ],
  "scripts": {
    "test": "vitest",
    "coverage": "pnpm test --coverage",
    "clean": "rimraf dist esm",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
    "typecheck": "tsrs --noEmit",
    "prebuild": "pnpm clean",
    "build:esm": "tsrs -p tsconfig.build.json --outDir esm",
    "build:es5": "tsrs -p tsconfig.build.json --module commonjs --moduleResolution bundler --outDir dist",
    "postbuild:es5": "echo '{\"type\": \"commonjs\"}' > dist/package.json",
    "preversion": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test --run && pnpm build",
    "postversion": "git push --follow-tags",
    "build": "pnpm build:esm && pnpm build:es5",
    "version": "git-cliff --tag v$npm_package_version --unreleased --prepend CHANGELOG.md && git add CHANGELOG.md"
  },
  "keywords": [
    "bionode",
    "biojs",
    "bam",
    "genomics"
  ],
  "dependencies": {
    "@gmod/bgzf-filehandle": "^6.8.0",
    "@gmod/shared-read-cache": "^2.1.0",
    "@jbrowse/quick-lru": "^8.0.0",
    "generic-filehandle2": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "crc": "^4.3.2",
    "git-cliff": "^2.14.2",
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
